{
  "name": "testpb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests index.html vite.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/rules.test.cjs tests/journey.test.cjs tests/navigation.test.cjs tests/enemy-skills.test.cjs tests/rogue.test.cjs tests/qinghe.test.cjs tests/growth.test.cjs tests/forest.test.cjs tests/guard-cadence.test.cjs tests/ward.test.cjs tests/localization.test.cjs",
    "test:language": "node tests/localization-browser.cjs",
    "test:browser": "node tests/browser-check.cjs",
    "test:deck": "node tests/deck-ui.cjs",
    "test:forest": "node tests/forest-browser.cjs",
    "test:growth-feedback": "node tests/growth-feedback.cjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:check": "node tests/desktop-check.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
